# Generated by matugen on every theme apply.
#
# These are NOT committed on purpose: config/ is symlinked into ~/.config, so
# anything written at runtime would leave the working tree permanently dirty.
# install.sh --theme regenerates all of them; a fresh clone has none until it runs.
config/quickshell/colors.json
config/kitty/colors.conf
config/hypr/conf/colors.lua
config/gtk-3.0/colors.css
config/gtk-4.0/colors.css
config/qt6ct/colors/hypersetup.conf
config/hypr/hyprlock-colors.conf

# Written by install.sh whenever the wallpaper changes: it is the only thing
# hyprpaper reads at startup, so it is what restores the wallpaper at login.
config/hypr/hyprpaper.conf

# Runtime state. Belongs in ~/.local/state/quickshell/, never in the repo —
# last wallpaper, launcher frecency, notification history, thumbnail cache.
state.json
*.log
.cache/

# Editor and OS noise
*~
*.swp
.DS_Store
__pycache__/
*.pyc
.idea/
.vscode/
