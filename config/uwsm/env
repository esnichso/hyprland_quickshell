# Session-wide environment, set BEFORE the compositor starts.
#
# Anything a toolkit reads at process start belongs here rather than in
# conf/env.lua — by the time Hyprland exports a variable, an app launched by
# the session manager may already have read the old value.

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

export GDK_BACKEND="wayland,x11"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland

export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Intel Arc / Arrow Lake hardware video decode.
export LIBVA_DRIVER_NAME=iHD

export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24

# Use the shell's own launcher for anything that asks for a terminal.
export TERMINAL=kitty
export EDITOR=nvim
export BROWSER=zen-browser
