// fastfetch.
//
// COLOUR COMES FROM THE TERMINAL, NOT FROM MATUGEN DIRECTLY. Every colour name
// below ("blue", "magenta", …) resolves to an ANSI slot, and those sixteen
// slots are already generated by config/matugen/templates/kitty-colors.conf.
// So this follows the wallpaper for free and needs no template of its own —
// which is the point of the one-code-path rule in CLAUDE.md. Do not add a
// fastfetch matugen target; there is nothing for it to generate.
//
// The trailing `colors` module prints those sixteen slots as blocks. That strip
// is how the duplicated-ANSI bug was found the first time (six of sixteen were
// byte-identical to three others) and it is why the module is last rather than
// decorative — check.sh's `ansi` section now catches that statically, but the
// strip is what makes a regression obvious at a glance.
//
// ICONS ARE WRITTEN AS \u ESCAPES, DELIBERATELY. These are private use area
// codepoints; pasted as literal characters they are invisible in a diff, in
// `cat`, and in a file viewer, and a rewriting tool can drop them silently —
// that is how 23 icon slots once shipped empty. JSON decodes \uXXXX natively,
// so the escape is both correct and readable. Keep it that way.
// The terminal font is JetBrainsMono Nerd Font (kitty.conf), a full v3 patch,
// so the whole Nerd Font range is available here — unlike the QML shell, which
// is limited to what ttf-nerd-fonts-symbols carries.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // No "source". fastfetch picks the logo from /etc/os-release, which cannot
    // be wrong; naming one ("cachyos") is a guess about fastfetch's builtin
    // logo list that this host cannot check, and a wrong name is a hard error
    // rather than a fallback.
    "logo": {
        "padding": { "top": 1, "left": 2, "right": 4 }
    },

    "display": {
        "separator": "  ",
        // Keys are icon + word. The width pads them into a column so the
        // values line up without a separator character doing the work.
        "key": { "width": 13 },
        "color": { "keys": "blue", "title": "magenta" }
    },

    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m──────────────────────────────\u001b[0m"
        },

        // --- the machine ---
        { "type": "os",       "key": "\uf17c  os" },
        { "type": "kernel",   "key": "\uf085  kernel" },
        { "type": "uptime",   "key": "\uf017  uptime" },
        { "type": "packages", "key": "\uf187  packages" },
        { "type": "shell",    "key": "\uf120  shell" },
        { "type": "terminal", "key": "\uf489  terminal" },

        "break",

        // --- the desktop ---
        //
        // These six are worth having for a reason beyond decoration: `wm`,
        // `theme`, `icons`, `font` and `cursor` read the LIVE GTK settings, so
        // this block is a one-command answer to "did the GTK half of the theme
        // actually apply?". A theme that failed to load reports Adwaita here
        // while still looking almost right on screen — the exact silent failure
        // CLAUDE.md warns about. check.sh's `desktop theming` section checks the
        // same thing without needing eyes on a terminal.
        { "type": "wm",      "key": "\uf2d0  wm" },
        { "type": "display", "key": "\uf108  display" },
        { "type": "theme",   "key": "\uf1fc  gtk theme" },
        { "type": "icons",   "key": "\uf03e  icons" },
        { "type": "font",    "key": "\uf031  font" },
        { "type": "cursor",  "key": "\uf245  cursor" },

        "break",

        // --- resources ---
        { "type": "cpu",    "key": "\uf2db  cpu" },
        { "type": "gpu",    "key": "\uf26c  gpu" },
        { "type": "memory", "key": "\uf538  memory" },
        { "type": "swap",   "key": "\uf1c0  swap" },
        { "type": "disk",   "key": "\uf0a0  disk" },

        // Absent in a VM, and fastfetch omits a module it cannot read rather
        // than printing a zero — the same call the bar's battery item makes.
        { "type": "battery",      "key": "\uf240  battery" },
        { "type": "poweradapter", "key": "\uf0e7  power" },

        "break",
        "colors",
        "break"
    ]
}
